# انسخ هذا الملف إلى .env وعدّل القيم للإنتاج
SECRET_KEY=change-me-to-a-long-random-secret
DATABASE_URL=sqlite:///./napex.db
UPLOAD_DIR=uploads
DEV_ACCEPT_ANY_OTP=true
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ Observability ============
# مقياس Prometheus مفعّل افتراضياً على /metrics
METRICS_ENABLED=true
# تتبع الأخطاء — اتركه فارغاً محلياً
SENTRY_DSN=

# ============ البنية التحتية ============
# Redis: OTP + كاش الحظر + WS pub/sub (فارغ = ذاكرة محلية)
REDIS_URL=redis://localhost:6379/0
# جدولة الاحتفاظ التلقائية (يومياً 02:00)
SCHEDULER_ENABLED=false

# ============ Blockchain Anchoring (اختياري — offline بدونها) ============
# فارغة = ختم Merkle محلي فقط. للتفعيل: شبكة اختبار Sepolia + محفظة بعقد EvidenceRegistry منشور
# BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/<key>
# BLOCKCHAIN_PRIVATE_KEY=0x...
# BLOCKCHAIN_CONTRACT_ADDRESS=0x...
# BLOCKCHAIN_CHAIN_ID=11155111

# ============ Blockchain Anchoring (اختياري — offline بدونها) ============
# فارغة = ختم Merkle محلي فقط. للتفعيل: شبكة اختبار Sepolia + محفظة بعقد EvidenceRegistry منشور
